{
  "expo": {
    "name": "MobileMonitor",
    "slug": "mobile-monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobilemonitor",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.minhhieu.mobilemonitor",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "location",
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "This app requires location access to monitor device status in the background.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app requires background location access to monitor device status when tabbed out.",
        "NSLocationAlwaysUsageDescription": "This app requires background location access to monitor device status when tabbed out."
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "./plugins/withDeviceMonitorIOS"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e2dce450-5777-4383-9acd-ab5747724862"
      }
    },
    "owner": "hieu1682004",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e2dce450-5777-4383-9acd-ab5747724862"
    },
    "android": {}
  }
}
