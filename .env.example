# ─── DATABASE & CORE ───
MONGO_URI=mongodb+srv://admin:password@your-cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=vmix_monitor
PORT=8000
TZ=Asia/Ho_Chi_Minh

# ─── DISCORD NOTIFICATIONS ───
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ─── REDIS CACHE (OPTIONAL) ───
# Redis giúp tăng tốc filter & hiển thị realtime nếu bạn install trên server
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=None

# ─── TIERED ROLLUP SETTINGS (OPTIONAL - DEFAULT CONFIGS) ───
# Các tham số cho hệ thống "Cuốn Chiếu" (Rolling stats)
TIER_RAW_WINDOW_SEC=180      # Biểu đồ realtime hiện 3 phút
TIER_1M_MAX_AGE_SEC=300    # Giữ đệm 1p trong 5 phút
TIER_5M_MAX_AGE_SEC=900    # Giữ đệm 5p trong 15 phút
TIER_ROLLUP_INTERVAL_SEC=15 # Cứ 15s server dọn dẹp và tính trung bình 1 lần
